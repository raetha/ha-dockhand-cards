{
  "name": "ha-dockhand-cards",
  "version": "1.4.0",
  "description": "Lovelace cards for the ha-dockhand Home Assistant integration",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm audit"
  },
  "license": "MIT",
  "author": "Raetha",
  "repository": {
    "type": "git",
    "url": "https://github.com/raetha/ha-dockhand-cards.git"
  },
  "dependencies": {
    "d3-shape": "^3.2.0",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/d3-shape": "^3.2.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "custom-card-helpers": "^2.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.12.0",
    "home-assistant-js-websocket": "^9.7.0",
    "jsdom": "^30.1.2",
    "rollup": "^4.64.5",
    "tslib": "^2.6.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
